{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Revenue and price register (skill forecast-revenue-and-price-ranges)",
 "type": "object",
 "required": [
  "asset",
  "markets",
  "basis",
  "adopted_forecast",
  "recommended_forecast",
  "probability_of_success",
  "countries",
  "failure_mode_screen",
  "gaps",
  "questions",
  "reviewer"
 ],
 "properties": {
  "adopted_forecast": {
   "const": "HUMAN ONLY"
  },
  "recommended_forecast": {
   "type": "null"
  },
  "markets": {
   "type": "array",
   "items": {
    "enum": [
     "US",
     "DE",
     "FR",
     "IT",
     "ES",
     "UK"
    ]
   }
  },
  "basis": {
   "type": "string",
   "description": "must contain the words unrisked and undiscounted"
  },
  "probability_of_success": {
   "type": "object",
   "properties": {
    "low": {
     "type": "number"
    },
    "mid": {
     "type": "number"
    },
    "high": {
     "type": "number"
    },
    "applied": {
     "const": false
    }
   }
  },
  "countries": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "country",
     "state"
    ],
    "properties": {
     "country": {
      "enum": [
       "US",
       "DE",
       "FR",
       "IT",
       "ES",
       "UK"
      ]
     },
     "currency": {
      "enum": [
       "USD",
       "EUR",
       "GBP"
      ]
     },
     "state": {
      "enum": [
       "computed",
       "GAP"
      ]
     },
     "peak_gross_range": {
      "type": "object"
     },
     "peak_net_range": {
      "type": "object"
     },
     "cumulative_gross_range": {
      "type": "object"
     },
     "cumulative_net_range": {
      "type": "object"
     },
     "net_price_set_by": {
      "type": "string"
     },
     "net_price_label": {
      "type": "string"
     },
     "sensitivity": {
      "type": "array"
     },
     "market_access_cross_check": {
      "type": "object"
     }
    }
   }
  },
  "failure_mode_screen": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "id",
     "state"
    ]
   }
  },
  "gaps": {
   "type": "array"
  },
  "questions": {
   "type": "array",
   "minItems": 1
  },
  "reviewer": {
   "type": "object"
  }
 }
}
