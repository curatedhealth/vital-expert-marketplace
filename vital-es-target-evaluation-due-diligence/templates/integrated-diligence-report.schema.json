{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Integrated diligence report (report.json written by tools/assemble_report.py)",
 "description": "Every line of the report carries register pointers. recommended_option is null and every option has recommended=false: the report never recommends. The validator in tools/assemble_report.py reads the keywords type, required, properties, items, enum, minItems and maxItems only.",
 "type": "object",
 "required": [
  "tool",
  "mode",
  "as_of",
  "thresholds",
  "assets",
  "sign_off",
  "recommended_option"
 ],
 "properties": {
  "tool": {
   "type": "string"
  },
  "mode": {
   "type": "string",
   "enum": [
    "asset",
    "company"
   ]
  },
  "as_of": {
   "type": "string"
  },
  "thresholds": {
   "type": "object"
  },
  "assets": {
   "type": "array",
   "minItems": 1,
   "items": {
    "type": "object",
    "required": [
     "asset",
     "answer",
     "workstreams",
     "top_risks",
     "conflicts",
     "conflict_checks",
     "open_gaps",
     "decision_options",
     "recommended_option",
     "deal_lead_decision"
    ],
    "properties": {
     "asset": {
      "type": "string"
     },
     "answer": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "object",
       "required": [
        "text",
        "pointers"
       ],
       "properties": {
        "text": {
         "type": "string"
        },
        "pointers": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "workstreams": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
       "type": "object",
       "required": [
        "code",
        "name",
        "skill",
        "present",
        "proposed_status",
        "rule_applied",
        "pointer",
        "deal_lead_confirmation",
        "deal_lead_status"
       ],
       "properties": {
        "code": {
         "type": "string",
         "enum": [
          "F",
          "A",
          "B",
          "C",
          "D",
          "E",
          "G",
          "R",
          "H"
         ]
        },
        "name": {
         "type": "string"
        },
        "skill": {
         "type": "string"
        },
        "present": {
         "type": "boolean"
        },
        "proposed_status": {
         "type": "string",
         "enum": [
          "green",
          "yellow",
          "red"
         ]
        },
        "rule_applied": {
         "type": "string"
        },
        "pointer": {
         "type": "string"
        },
        "route_to": {
         "type": [
          "string",
          "null"
         ]
        },
        "consequence": {
         "type": [
          "string",
          "null"
         ]
        },
        "deal_lead_confirmation": {
         "type": "string",
         "enum": [
          "PENDING"
         ]
        },
        "deal_lead_status": {
         "type": [
          "string",
          "null"
         ]
        }
       }
      }
     },
     "top_risks": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "rank",
        "workstream",
        "kind",
        "text",
        "pointers"
       ],
       "properties": {
        "rank": {
         "type": "integer"
        },
        "workstream": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "text": {
         "type": "string"
        },
        "pointers": {
         "type": "array",
         "minItems": 1,
         "items": {
          "type": "string"
         }
        }
       }
      }
     },
     "conflicts": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "rule",
        "status",
        "left",
        "right",
        "detail"
       ],
       "properties": {
        "rule": {
         "type": "string"
        },
        "status": {
         "type": "string",
         "enum": [
          "conflict",
          "not comparable",
          "dependency"
         ]
        },
        "left": {
         "type": "object",
         "required": [
          "workstream",
          "pointer",
          "text"
         ],
         "properties": {
          "workstream": {
           "type": "string"
          },
          "pointer": {
           "type": "string"
          },
          "text": {
           "type": "string"
          }
         }
        },
        "right": {
         "type": "object",
         "required": [
          "workstream",
          "pointer",
          "text"
         ],
         "properties": {
          "workstream": {
           "type": "string"
          },
          "pointer": {
           "type": "string"
          },
          "text": {
           "type": "string"
          }
         }
        },
        "detail": {
         "type": "string"
        }
       }
      }
     },
     "conflict_checks": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "rule",
        "status",
        "pointers"
       ]
      }
     },
     "open_gaps": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "workstream",
        "kind",
        "pointer",
        "missing",
        "why_it_matters",
        "blocks"
       ],
       "properties": {
        "workstream": {
         "type": "string"
        },
        "kind": {
         "type": "string"
        },
        "pointer": {
         "type": "string"
        },
        "missing": {
         "type": "string"
        },
        "why_it_matters": {
         "type": "string"
        },
        "blocks": {
         "type": "string"
        }
       }
      }
     },
     "decision_options": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
       "type": "object",
       "required": [
        "option",
        "recommended"
       ],
       "properties": {
        "option": {
         "type": "string",
         "enum": [
          "sign",
          "sign with conditions",
          "do not sign"
         ]
        },
        "recommended": {
         "type": "boolean",
         "enum": [
          false
         ]
        },
        "conditions_that_would_have_to_hold": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "condition",
           "pointers"
          ],
          "properties": {
           "condition": {
            "type": "string"
           },
           "pointers": {
            "type": "array",
            "minItems": 1,
            "items": {
             "type": "string"
            }
           }
          }
         }
        },
        "conditions_precedent": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "condition",
           "pointers"
          ],
          "properties": {
           "condition": {
            "type": "string"
           },
           "pointers": {
            "type": "array",
            "minItems": 1,
            "items": {
             "type": "string"
            }
           }
          }
         }
        },
        "conditions_present": {
         "type": "array",
         "items": {
          "type": "object",
          "required": [
           "condition",
           "pointers"
          ],
          "properties": {
           "condition": {
            "type": "string"
           },
           "pointers": {
            "type": "array",
            "minItems": 1,
            "items": {
             "type": "string"
            }
           }
          }
         }
        }
       }
      }
     },
     "recommended_option": {
      "type": "null"
     },
     "deal_lead_decision": {
      "type": "string",
      "enum": [
       "PENDING (HUMAN ONLY)"
      ]
     }
    }
   }
  },
  "sign_off": {
   "type": "object",
   "required": [
    "prepared_by",
    "reviewed_by",
    "deal_lead_decision",
    "version",
    "release_state",
    "status"
   ],
   "properties": {
    "deal_lead_decision": {
     "type": "string",
     "enum": [
      "PENDING (HUMAN ONLY)"
     ]
    },
    "status": {
     "type": "string"
    }
   }
  },
  "rollup": {
   "type": "object"
  },
  "added_lines": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "text",
     "pointers"
    ],
    "properties": {
     "text": {
      "type": "string"
     },
     "pointers": {
      "type": "array",
      "minItems": 1,
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "recommended_option": {
   "type": "null"
  }
 }
}
