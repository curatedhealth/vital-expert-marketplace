{
  "version": "0.3.1",
  "pack": "vital-mlr-review",
  "routing_harness": "mcps/mlr_review/tests/test_skills.py",
  "script_self_tests": [
    "plugin/vital-mlr-review/scripts/check_forbidden_phrases.py --self-test",
    "plugin/vital-mlr-review/scripts/check_finding_shape.py --self-test",
    "plugin/vital-mlr-review/scripts/check_jurisdictions.py --self-test",
