{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "title": "Benchmark register (skill compare-deal-terms-to-benchmarks)",
 "type": "object",
 "required": [
  "asset",
  "status",
  "adopted_valuation",
  "recommended_valuation",
  "results",
  "failure_mode_screen",
  "gaps",
  "questions",
  "reviewer"
 ],
 "properties": {
  "adopted_valuation": {
   "const": "HUMAN ONLY"
  },
  "recommended_valuation": {
   "type": "null"
  },
  "status": {
   "enum": [
    "UNSIGNED",
    "SIGNED"
   ]
  },
  "results": {
   "type": "object"
  },
  "failure_mode_screen": {
   "type": "array"
  },
  "gaps": {
   "type": "array"
  },
  "questions": {
   "type": "array",
   "minItems": 1
  },
  "reviewer": {
   "type": [
    "object",
    "null"
   ]
  }
 }
}
